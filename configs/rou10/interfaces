# /etc/network/interfaces — Rou10 (router de borde)
source /etc/network/interfaces.d/*

# The loopback network interface
auto lo
iface lo inet loopback

# Red externa (DHCP): adaptador NAT de VMware, salida a internet
allow-hotplug ens32
iface ens32 inet dhcp

# Red interna (estática): VMnet10
auto ens33
iface ens33 inet static
        address 192.168.10.1
        netmask 255.255.255.0

# Rutas estáticas hacia las subredes que cuelgan de Rou11..Rou15
up ip route add 192.168.11.0/24 via 192.168.10.11
up ip route add 192.168.12.0/24 via 192.168.10.12
up ip route add 192.168.13.0/24 via 192.168.10.13
up ip route add 192.168.14.0/24 via 192.168.10.14
up ip route add 192.168.15.0/24 via 192.168.10.15
